# --- Settings ---
T_total <- 1000
dt <- 1
time <- seq(0, T_total, by = dt)

# Base parameters
k <- 3
theta_base <- 20
k_CM <- 0.02              # C -> M
k_CN_base <- 0.01         # C -> N
k_NC_base <- 0.02         # N -> C

simulate_3state <- function(C, E, n_sim = 300) {
  
  results <- matrix(0, nrow = n_sim, ncol = 3)
  colnames(results) <- c("M", "C", "N")
  
  for (s in 1:n_sim) {
    
    theta <- theta_base / (1 + C)
    k_MC <- 1 / (k * theta)
    
    k_CN <- k_CN_base * (1 + C)
    k_NC <- k_NC_base * exp(-0.5 * E)
    
    state <- numeric(length(time))
    state[1] <- 0
    
    for (t in 2:length(time)) {
      
      if (state[t-1] == 0) {
        p <- min(1, k_MC * dt)
        state[t] <- ifelse(rbinom(1,1,p)==1, 1, 0)
        
      } else if (state[t-1] == 1) {
        p_CM <- min(1, k_CM * dt)
        p_CN <- min(1, k_CN * dt)
        
        r <- runif(1)
        if (r < p_CM) {
          state[t] <- 0
        } else if (r < p_CM + p_CN) {
          state[t] <- 2
        } else {
          state[t] <- 1
        }
        
      } else if (state[t-1] == 2) {
        p <- min(1, k_NC * dt)
        state[t] <- ifelse(rbinom(1,1,p)==1, 1, 2)
      }
    }
    
    results[s,1] <- mean(state == 0)
    results[s,2] <- mean(state == 1)
    results[s,3] <- mean(state == 2)
  }
  
  colMeans(results)
}

# --- Run conditions ---
C0_S <- simulate_3state(C=0, E=0)
C0_L <- simulate_3state(C=0, E=1)
C1_S <- simulate_3state(C=1, E=0)
C1_L <- simulate_3state(C=1, E=1)

# Combine
res <- rbind(C0_S, C0_L, C1_S, C1_L)
rownames(res) <- c("C0_S", "C0_L", "C1_S", "C1_L")

