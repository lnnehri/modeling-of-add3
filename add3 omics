# --- Settings --- Salomon et al daki bilgiyle ben simdi
#modelliyorum nucleusa girse cikisi naisl olur diye

T_total <- 1000
dt <- 1
time <- seq(0, T_total, by = dt)

# Calcium & exon
C <- 1      # 0 or 1
E <- 1      # 0=short, 1=long

# ---- Rates from Model I ----
k <- 3
theta_base <- 20
theta <- theta_base / (1 + C)

k_MC <- 1 / (k * theta)          # M -> C (activation/release)
k_CM <- 0.02                     # C -> M (re-stabilization)

# Nuclear shuttling
k_CN_base <- 0.01                # C -> N entry
k_NC_base <- 0.02                # N -> C export

k_CN <- k_CN_base * (1 + C)      # calcium increases entry
k_NC <- k_NC_base * exp(-0.5 * E)  # exon14 slows export

# --- State coding ---
# 0 = M (membrane-bound)
# 1 = C (cytoplasmic free)
# 2 = N (nuclear)

state <- numeric(length(time))
state[1] <- 0   # start in M

for (t in 2:length(time)) {
  
  if (state[t-1] == 0) {
    # M -> C
    p <- min(1, k_MC * dt)
    state[t] <- ifelse(rbinom(1,1,p)==1, 1, 0)
    
  } else if (state[t-1] == 1) {
    # C -> M or N
    p_CM <- min(1, k_CM * dt)
    p_CN <- min(1, k_CN * dt)
    
    r <- runif(1)
    if (r < p_CM) {
      state[t] <- 0
    } else if (r < p_CM + p_CN) {
      state[t] <- 2
    } else {
      state[t] <- 1
    }
    
  } else if (state[t-1] == 2) {
    # N -> C
    p <- min(1, k_NC * dt)
    state[t] <- ifelse(rbinom(1,1,p)==1, 1, 2)
  }
}

# ---- Occupancy fractions ----
M_frac <- mean(state == 0)
C_frac <- mean(state == 1)
N_frac <- mean(state == 2)

M_frac
C_frac
N_frac

plot(time, state, type="s",
     ylab="State (0=M,1=C,2=N)",
     xlab="Time",
     main="3-state ADD3-L dynamics")

