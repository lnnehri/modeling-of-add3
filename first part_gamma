### ortak simulasyon
simulate_activation <- function(C, n_sim = 100) {
  lambda <- lambda_0 + lambda_1 * C
  theta <- theta_base / (1 + C)
  
  scores <- numeric(n_sim)
  
  for (i in 1:n_sim) {
    T_act <- rgamma(1, shape = k, scale = theta)
    state <- rep(0, length(time))
    state[time >= T_act] <- 1
    scores[i] <- mean(state)
  }
  
  return(scores)
}

