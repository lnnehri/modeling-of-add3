###exon etkisi katiyorum
# Exon14 etkisi: 0=ADD3-S, 1=ADD3-L
# ADD3-L için aktivasyon artar (kAB ↑) ve geri dönüş azalır (kBA ↓)
alpha_E <- 2.0   # exon14'ün kAB'yi artırma katsayısı
beta_E  <- 0.5   # exon14'ün kBA'yı azaltma katsayısı
simulate_switching_score_isoform <- function(C, E, n_sim = 200) {
  # Base rates from your model
  theta <- theta_base / (1 + C)
  kAB_base <- 1 / (k * theta)               # A -> B
  kBA_base <- max(1e-6, kBA_0 - kBA_1 * C)  # B -> A
  
  # Exon14 modulation
  kAB <- kAB_base * exp(alpha_E * E)
  kBA <- kBA_base * exp(-beta_E  * E)
  
  scores <- numeric(n_sim)
  
  for (i in 1:n_sim) {
    state <- rep(0, length(time))  # 0=A, 1=B
    for (t in 2:length(time)) {
      if (state[t-1] == 0) {
        p <- min(1, kAB * dt)
        state[t] <- rbinom(1, 1, p)
      } else {
        p <- min(1, kBA * dt)
        back <- rbinom(1, 1, p)
        state[t] <- ifelse(back == 1, 0, 1)
      }
    }
    scores[i] <- mean(state)
  }
  scores
}
set.seed(1)

