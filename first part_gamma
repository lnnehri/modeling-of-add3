#treshold bakiyorum
# --- 1) Ayarlar ---
T_total <- 1000
dt <- 1
time <- seq(0, T_total, by = dt)

# Model parametreleri (seninkiler)
lambda_0 <- 0.01
lambda_1 <- 0.05
k <- 3
theta_base <- 20

# --- 2) Tek bir C için simülasyon fonksiyonu ---
simulate_activation_cont <- function(C, n_sim = 100) {
  lambda <- lambda_0 + lambda_1 * C
  theta  <- theta_base / (1 + C)
  
  scores <- numeric(n_sim)
  for (i in 1:n_sim) {
    T_act <- rgamma(1, shape = k, scale = theta)  # aktivasyon zamanı
    state <- rep(0, length(time))
    state[time >= T_act] <- 1
    scores[i] <- mean(state)
  }
  scores
}

# --- 3) Continuous C taraması ---
C_grid <- seq(0, 1, by = 0.05)
res_list <- lapply(C_grid, simulate_activation_cont, n_sim = 100)

mean_score <- sapply(res_list, mean)
low_ci     <- sapply(res_list, function(x) quantile(x, 0.05))
high_ci    <- sapply(res_list, function(x) quantile(x, 0.95))

# --- 4) Çizim: doz-yanıt eğrisi + belirsizlik bandı ---
plot(C_grid, mean_score, type = "b",
     xlab = "Calcium context (C, continuous)",
     ylab = "ADD3-L activation score (fraction of time active)",
     main = "Continuous calcium effect on ADD3-L activation",
     ylim = c(min(low_ci), max(high_ci)))

lines(C_grid, low_ci, lty = 2)
lines(C_grid, high_ci, lty = 2)
legend("bottomright",
       legend = c("Mean", "5–95% range"),
       lty = c(1, 2), bty = "n")

###simdi B'den A'ya geri donus yapiyoruz, stabilizasyon nasil olur 
# B -> A (deaktivasyon / geri stabilizasyon) hızı:
# calcium arttıkça geri dönüş zorlaşsın diye azalttık
kBA_0 <- 0.02   # bazal geri dönüş hızı
kBA_1 <- 0.015  # kalsiyumun geri dönüşü azaltan etkisi
kBA <- max(1e-6, kBA_0 - kBA_1 * C)  # negatif olmasın diye sınır koyduk

# A -> B (aktivasyon) hızı: beklenen aktivasyon süresinin tersi
kAB <- 1 / (k * theta)
state <- rep(0, length(time))  # 0=A (stable), 1=B (active)
state[1] <- 0                  # başlangıç A

for (t in 2:length(time)) {
  if (state[t-1] == 0) {
    # A'daysak: B'ye geçiş olasılığı ~ kAB * dt
    p <- min(1, kAB * dt)
    state[t] <- rbinom(1, 1, p)
  } else {
    # B'deysek: A'ya dönüş olasılığı ~ kBA * dt
    p <- min(1, kBA * dt)
    back_to_A <- rbinom(1, 1, p)
    state[t] <- ifelse(back_to_A == 1, 0, 1)
  }
}

activation_score <- mean(state)
activation_score
plot(time, state, type = "s",
     ylab = "ADD3 state (0=stable, 1=active)",
     xlab = "Time",
     main = "A <-> B switching with B->A back-transition")
simulate_switching_score <- function(C, n_sim = 100) {
  # Parametreler
  theta <- theta_base / (1 + C)
  kAB <- 1 / (k * theta)               # A -> B
  
  kBA <- max(1e-6, kBA_0 - kBA_1 * C)  # B -> A (calcium arttıkça azalır)
  
  scores <- numeric(n_sim)
  
  for (i in 1:n_sim) {
    state <- rep(0, length(time))
    state[1] <- 0
    
    for (t in 2:length(time)) {
      if (state[t-1] == 0) {
        p <- min(1, kAB * dt)
        state[t] <- rbinom(1, 1, p)
      } else {
        p <- min(1, kBA * dt)
        back_to_A <- rbinom(1, 1, p)
        state[t] <- ifelse(back_to_A == 1, 0, 1)
      }
    }
    scores[i] <- mean(state)
  }
  scores
}

# İki koşul için dağılımlar
scores_lowCa  <- simulate_switching_score(C = 0, n_sim = 100)
scores_highCa <- simulate_switching_score(C = 1, n_sim = 100)
