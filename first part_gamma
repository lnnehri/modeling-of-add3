# Simülasyonun toplam süresi ve zaman çözünürlüğü
T_total <- 1000   # simülasyonun ne kadar uzun süreceğini belirler
dt <- 1           # her adımda zamanın ne kadar ilerlediğini belirler
time <- seq(0, T_total, by = dt)  # simülasyonda ilerlenen zaman noktaları

#binary
# Calcium context (ortam kalsiyum durumu)
# C = 0 : calcium-poor ortam → ADD3-L genelde stabil (actin-bound)
# C = 1 : calcium-rich ortam → Ca2+-CaM aktivasyonu olası, metastatik davranış artar
C <- 1

# Poisson süreci için Ca2+-CaM'nin ADD3-L ile karşılaşma hızı
lambda_0 <- 0.01     # calciumdan bağımsız, bazal karşılaşma hızı
lambda_1 <- 0.05     # kalsiyumun karşılaşma hızını artıran etkisi
lambda <- lambda_0 + lambda_1 * C  # toplam CaM–ADD3 temas hızı

# Gamma dağılımı: ADD3-L'nin aktif hale geçmesi için gereken süre
k <- 3                 # aktivasyon için gereken etkin CaM teması sayısı
theta_base <- 20       # calcium-poor ortamda aktivasyonun karakteristik süresi
theta <- theta_base / (1 + C)  # calcium arttıkça aktivasyon süresi kısalır

# ADD3-L'nin Ca2+-CaM ile aktive olmasına kadar geçen süre
T_act <- rgamma(1, shape = k, scale = theta)

T_act
replicate(10, rgamma(1, k, theta))

# Durum vektörü: A = 0 (stable), B = 1 (active/metastatic)
state <- rep(0, length(time))

# A -> B geçişi
state[time >= T_act] <- 1
# ADD3-L'nin aktif durumda geçirdiği zaman oranı
activation_score <- mean(state)

activation_score
plot(time, state, type = "s",
     ylab = "ADD3 state (0=stable, 1=active)",
     xlab = "Time")

