set.seed(1)

# Hücre yarıçapı boyunca noktalar
n_points <- 5000
r <- runif(n_points, min = 0, max = 1)  # 0 = merkez, 1 = membran

# Calcium alanı Ca(x): çepere doğru artan + gürültü
Ca_mean <- 0.3 + 0.8 * r
Ca_sd   <- 0.15

Ca_x <- rnorm(n_points, mean = Ca_mean, sd = Ca_sd)
Ca_x[Ca_x < 0] <- 0  # negatif olmasın
summary(Ca_x)

# ---- Ca(x) → Poisson hızına çevir ----
lambda_base <- 0.2    # bazal CaM aktivasyon oranı
lambda_scale <- 1.5   # calciumun olaya etkisi

lambda_x <- lambda_base + lambda_scale * Ca_x
# Simülasyon süresi
T_window <- 10  # örn. 10 zaman birimi

# Her uzamsal noktadaki Ca–CaM event sayısı
CaM_events <- rpois(length(lambda_x), lambda = lambda_x * T_window)
# Radius'a karşı event sayısı
plot(r, CaM_events,
     pch = 16, cex = 0.4,
     xlab = "Radius r",
     ylab = "Number of Ca–CaM events",
     main = "Poisson Ca–CaM activation events across cell radius")
