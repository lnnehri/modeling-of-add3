###STE4 Exon-14 ekliyoruz
set.seed(1)

# Hücre yarıçapı
R <- 1

# Exon-14 konumu (çepere yakın)
exon_pos <- c(0.8, 0, 0)  # (x,y,z)
n_points <- 2000

# Küre içinde rastgele noktalar
rand_unit_sphere <- function(n) {
  u <- matrix(rnorm(3*n), ncol=3)
  u <- u / sqrt(rowSums(u^2))
  r <- runif(n)^(1/3)
  u * r
}

coords <- rand_unit_sphere(n_points)
r <- sqrt(rowSums(coords^2))

# Bazal Ca alanı
Ca_base <- 0.3 + 0.8 * r
# Exon etkisi
hotspot_radius <- 0.15
hotspot_strength <- 1.8  # lokal Ca artışı

# Exon noktasına mesafe
dist_exon <- sqrt(rowSums((coords -
                             matrix(exon_pos, nrow=n_points,
                                    ncol=3, byrow=TRUE))^2))

# ADD3-S (E=0): değişiklik yok
Ca_S <- Ca_base

# ADD3-L (E=1): hotspot varsa Ca artar
Ca_L <- Ca_base
Ca_L[dist_exon < hotspot_radius] <-
  Ca_L[dist_exon < hotspot_radius] * hotspot_strength
summary(Ca_S)
summary(Ca_L)
# Poisson parametreleri
lambda_base  <- 0.5    # Ca'dan bağımsız bazal aktivite
lambda_scale <- 2.0    # Ca'nın olaya katkısı

# ADD3-S ve ADD3-L için yerel Poisson hızları
lambda_S <- lambda_base + lambda_scale * Ca_S
lambda_L <- lambda_base + lambda_scale * Ca_L
events_S <- rpois(n_points, lambda = lambda_S)
events_L <- rpois(n_points, lambda = lambda_L)
mean(events_S); mean(events_L)
quantile(events_S, c(0.05, 0.5, 0.95))
quantile(events_L, c(0.05, 0.5, 0.95))
plot(r, events_L,
     pch = 16, cex = 0.4,
     xlab = "Radius r",
     ylab = "Poisson Ca–CaM events",
     main = "Spatial Poisson Ca–CaM activation (ADD3-L)")


