## --- Gamma tabanlı aktivasyon süresi ---
# Poisson Ca–CaM hitlerinden gelen Gamma
k <- 3
theta_base <- 2          # aktivasyonun karakteristik süresi
C <- 1                   # calcium context (0–1 arası olabilir)

theta <- theta_base / (1 + C)

# Gamma’dan tek bir aktivasyon süresi örneği
T_act <- rgamma(1, shape = k, scale = theta)

# Gamma → Markov geçiş hızı
kAB <- 1 / T_act
kAB
## --- Markov switching ---
T_total <- 1000
dt <- 1
time <- seq(0, T_total, by = dt)

# Geri dönüş hızı (B → A)
kBA_0 <- 0.02
kBA_1 <- 0.015
kBA <- max(1e-6, kBA_0 - kBA_1 * C)

state <- rep(0, length(time))  # 0 = A (stable), 1 = B (active)

for (t in 2:length(time)) {
  if (state[t-1] == 0) {
    state[t] <- rbinom(1, 1, min(1, kAB * dt))
  } else {
    state[t] <- ifelse(rbinom(1, 1, min(1, kBA * dt)) == 1, 0, 1)
  }
}

activation_score <- mean(state)
activation_score
plot(time, state, type = "s",
     ylab = "ADD3 state (0 = stable, 1 = active)",
     xlab = "Time",
     main = "Gamma-driven Markov switching (A ⇄ B)")


#######COKLU MARKOV
set.seed(1)

# --- Zaman ---
T_total <- 1000
dt <- 1
time <- seq(0, T_total, by = dt)

# --- Parametreler ---
k <- 3
theta_base <- 20

kBA_0 <- 0.02
kBA_1 <- 0.015

# --- Tek hücre için dwell time hesaplayan fonksiyon ---
simulate_dwell_times <- function(C) {
  
  theta <- theta_base / (1 + C)
  kAB <- 1 / (k * theta)                 # A -> B
  kBA <- max(1e-6, kBA_0 - kBA_1 * C)    # B -> A
  
  state <- rep(0, length(time))          # 0=A, 1=B
  dwell_B <- c()
  current_dwell <- 0
  
  for (t in 2:length(time)) {
    if (state[t-1] == 0) {
      state[t] <- rbinom(1, 1, min(1, kAB * dt))
    } else {
      back <- rbinom(1, 1, min(1, kBA * dt))
      state[t] <- ifelse(back == 1, 0, 1)
    }
    
    # B durumunda kalış süresi
    if (state[t] == 1) {
      current_dwell <- current_dwell + dt
    } else {
      if (current_dwell > 0) {
        dwell_B <- c(dwell_B, current_dwell)
        current_dwell <- 0
      }
    }
  }
  
  dwell_B
}
n_cells <- 1000

dwell_low  <- unlist(replicate(n_cells, simulate_dwell_times(C = 0), simplify = FALSE))
dwell_high <- unlist(replicate(n_cells, simulate_dwell_times(C = 1), simplify = FALSE))
par(mfrow = c(1,2), mar = c(5,5,4,1))

hist(dwell_low,
     breaks = 40,
     col = rgb(0.2,0.4,1,0.6),
     border = NA,
     main = "Calcium-poor (C=0)\nB-state dwell time",
     xlab = "Time in active state")

hist(dwell_high,
     breaks = 40,
     col = rgb(1,0.3,0.3,0.6),
     border = NA,
     main = "Calcium-rich (C=1)\nB-state dwell time",
     xlab = "Time in active state")

par(mfrow = c(1,1))
mean(dwell_low);  sd(dwell_low)
mean(dwell_high); sd(dwell_high)
#yukaridaki histogram veriyor simdi baska
# ECDF plot for B-state dwell time
plot(ecdf(dwell_low),
     col = "blue", lwd = 3,
     xlab = "Time in active state (B-state dwell time)",
     ylab = "Cumulative probability",
     main = "ECDF of B-state dwell time")

lines(ecdf(dwell_high),
      col = "red", lwd = 3)

legend("bottomright",
       legend = c("Calcium-poor (C=0)", "Calcium-rich (C=1)"),
       col = c("blue", "red"),
       lwd = 3,
       bty = "n")
