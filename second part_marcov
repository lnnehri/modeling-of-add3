###3D model
## =========================
## STEP 1 — Spatial Ca(x) field in a 3D spherical cell
## =========================

set.seed(1)

# --- 1) Cell geometry (3D sphere) ---
R_cell <- 1.0                 # cell radius (arbitrary units)
step   <- 0.08                # grid resolution (smaller = finer, slower)
coords <- expand.grid(
  x = seq(-R_cell, R_cell, by = step),
  y = seq(-R_cell, R_cell, by = step),
  z = seq(-R_cell, R_cell, by = step)
)
coords$r <- sqrt(coords$x^2 + coords$y^2 + coords$z^2)

# keep only points inside the sphere
cell <- coords[coords$r <= R_cell, ]
n <- nrow(cell)

# --- 2) Calcium baseline profile: higher near membrane ---
# radial mean profile mu(r): increases toward r=R_cell
Ca_min <- 0.2
Ca_max <- 1.0
cell$mu_r <- Ca_min + (Ca_max - Ca_min) * (cell$r / R_cell)^pmax(1, 1)  # linear in r

# add multiplicative noise (log-normal is nice for positive concentrations)
sigma_ln <- 0.25
cell$Ca_base <- rlnorm(n, meanlog = log(cell$mu_r), sdlog = sigma_ln)

# --- 3) Exon-14 "calcium island" as a local bias (only for E=1) ---
E <- 1               # 0=ADD3-S, 1=ADD3-L  (change later if needed)
delta_E <- 0.7       # 70% local increase near exon site (your hypothesis)

# choose an exon-14 location inside the cell (example: near cortex)
exon_pos <- c(x = 0.6, y = 0.0, z = 0.0) * R_cell
island_radius <- 0.18 * R_cell

dist_to_exon <- sqrt((cell$x - exon_pos["x"])^2 + (cell$y - exon_pos["y"])^2 + (cell$z - exon_pos["z"])^2)
cell$is_island <- dist_to_exon <= island_radius

# apply local boost only if E=1
cell$Ca <- cell$Ca_base * ifelse(E == 1 & cell$is_island, (1 + delta_E), 1)

# --- 4) Quick sanity checks (numbers + simple 1D summaries) ---
cat("Points in cell:", n, "\n")
cat("Ca summary (all):\n"); print(summary(cell$Ca))
cat("Ca mean in island vs outside:\n")
print(tapply(cell$Ca, cell$is_island, mean))

# optional quick plot: Ca vs radius
plot(cell$r, cell$Ca, pch = 16, cex = 0.4,
     xlab = "Radius r", ylab = "Calcium Ca(x)",
     main = "Spatial calcium field Ca(x) inside spherical cell")


